# Firebase web configuration. These values are designed to be public.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin credentials. Keep these server-only and never commit them.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Enable only after Firebase Admin, validation and abuse protection are ready.
CONTACT_ENABLED=false
APP_ORIGIN=http://localhost:3001
# Optional future gallery adapter, no Cloudinary account is required for local assets.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
