# Cloudinary server credential. Never expose this value to the browser or commit it.
# Copy the full API environment variable from Cloudinary Console → Settings → API Keys.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Canonical public URL. Update when moving to a custom domain.
NEXT_PUBLIC_SITE_URL=https://chicassc.com
# Optional verification codes from Google Search Console and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
